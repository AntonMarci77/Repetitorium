# Repetitórium — vzor konfigurácie. Skopíruj do .env.local a doplň hodnoty.
# .env.local NESMIE byť commitnuté (musí byť v .gitignore).

# Formspree – nahlasovanie opráv
# VEREJNÉ (smie byť v repe aj v klientskom JS bundli):
NEXT_PUBLIC_FORMSPREE_PROJECT=3008021928981036103

# TAJNÉ – NEcommitovať! Nastav v Vercel (Project Settings → Environment Variables)
# a lokálne v .env.local. Používa sa len pri `npx @formspree/cli deploy`.
FORMSPREE_DEPLOY_KEY=
